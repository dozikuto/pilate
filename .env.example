# ============================================================
# PilatesMS – Tệp cấu hình môi trường duy nhất (Root .env)
# Sao chép file này thành .env tại thư mục gốc để chạy toàn bộ hệ thống
# ============================================================

# Cấu hình chung Backend
NODE_ENV=development
PORT=3001
APP_NAME=PilatesMS

# Cơ sở dữ liệu PostgreSQL (Khớp với docker-compose 5433:5432)
DB_HOST=localhost
DB_PORT=5433
DB_USER=pilates
DB_PASSWORD=pilates123
DB_NAME=pilatesms
DB_SYNC=true
DB_LOGGING=false

# Cache Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Xác thực bảo mật JWT
JWT_SECRET=pilatesms_jwt_secret_dev_2026
JWT_ACCESS_SECRET=pilatesms_jwt_secret_dev_2026
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_SECRET=pilatesms_refresh_secret_dev_2026
JWT_REFRESH_EXPIRES_IN=30d

# Mã bảo mật QR Check-in
QR_SECRET=pilatesms_qr_secret_dev

# Cấu hình cho Web Admin (Vite tự nạp từ file gốc này)
VITE_API_URL=http://localhost:3001/api/v1
WEB_ADMIN_URL=http://localhost:5173

# Cấu hình cho Mobile App (Expo tự nạp từ file gốc này)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_APP_NAME=PilatesMS
MOBILE_URL=exp://localhost:8081

# Dịch vụ mở rộng (Tùy chọn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
